POST attachmentCreate auth=Bearer fake-local-token vars={"input": {"issueId": "uuid-PC-101", "title": "a-desktop.png", "url": "https://uploads.linear.example/a-desktop.png"}}
POST issue auth=Bearer fake-local-token vars={"id": "PC-101"}

