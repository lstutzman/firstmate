{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Progress officer discovery run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "date", "generated_at", "doing", "done", "start_requests", "asks_for_lee", "excluded", "unclassified", "filler", "coverage"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"const": "progress-officer"},
    "date": {"type": "string"},
    "generated_at": {"type": "string"},
    "doing": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "done": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "start_requests": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "asks_for_lee": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "excluded": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "unclassified": {"type": "integer", "minimum": 0},
    "coverage": {"type": "array", "items": {"type": "string"}},
    "linear_coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["pages_fetched", "items_seen", "requests", "roots_visited", "hierarchy_items", "rate_limit_retries", "team_items", "unblocked_items"],
      "properties": {
        "team_items": {"type": "integer", "minimum": 0},
        "unblocked_items": {"type": "integer", "minimum": 0},
        "pages_fetched": {"type": "integer", "minimum": 0},
        "items_seen": {"type": "integer", "minimum": 0},
        "requests": {"type": "integer", "minimum": 0},
        "roots_visited": {"type": "integer", "minimum": 0},
        "hierarchy_items": {"type": "integer", "minimum": 0},
        "rate_limit_retries": {"type": "integer", "minimum": 0}
      }
    },
    "filler": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "reason", "tag_source", "requires_firstmate", "execute"],
      "properties": {
        "kind": {"enum": ["bug sweep", "code review", "librarian pass", "ideation pass"]},
        "reason": {"type": "string"},
        "tag_source": {"const": "standing-authority:filler"},
        "requires_firstmate": {"const": true},
        "execute": {"$ref": "#/$defs/execute"}
      }
    }
  },
  "$defs": {
    "execute": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["action", "env", "request_id", "argv"],
      "properties": {
        "action": {"const": "start"},
        "env": {
          "type": "object", "additionalProperties": false, "required": ["FM_HOME"],
          "properties": {"FM_HOME": {"type": "string"}}
        },
        "request_id": {"type": "string"},
        "argv": {"type": "array", "items": {"type": "string"}}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "owner_home", "linear_id", "linear_ids", "authorising_class", "tag_source", "reason", "evidence", "priority", "rank", "execute"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "owner_home": {"type": "string"},
        "linear_id": {"type": ["string", "null"]},
        "linear_ids": {"type": "array", "items": {"type": "string"}},
        "authorising_class": {"enum": ["security", "cve", "code-review", "bug", "requested-feature", "requested-fleet", null]},
        "tag_source": {"type": ["string", "null"]},
        "reason": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "priority": {"enum": [0, 1, 2, 3, 4]},
        "rank": {"type": ["integer", "null"]},
        "execute": {"$ref": "#/$defs/execute"},
        "link": {"type": "string"},
        "project": {"type": "string"},
        "outcome": {"enum": ["ok", "failed", "skipped"]},
        "captains_log_key": {"type": "string"}
      }
    }
  }
}
